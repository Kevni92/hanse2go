{
  "name": "hanse2go",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"pnpm --filter @hanse2go/server dev\" \"pnpm --filter @hanse2go/client dev\"",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
